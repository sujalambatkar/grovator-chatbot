# Public URL of the Grovator Assistant API (FastAPI). The browser calls it directly.
# There is NO Groq key here and there must never be one: it lives only on the backend.
NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:8000

# Instant (0-token) answers wait this many milliseconds so the typing dots show first (0 = no delay)
NEXT_PUBLIC_MIN_THINK_MS=600
