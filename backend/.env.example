GROQ_API_KEY=



# Must match the secret Grovator uses to sign JWTs (>= 32 chars). Dev default only.
JWT_SECRET=change-me-to-a-32-plus-character-secret
# "memory" = embedded (tests/quick demo); http://localhost:6333 = docker compose Qdrant
QDRANT_URL=http://localhost:6333
MIN_RETRIEVAL_SCORE=0.55
ROUTER_MODEL=openai/gpt-oss-20b
ANSWER_MODEL=openai/gpt-oss-120b
GUARD_MODEL=openai/gpt-oss-safeguard-20b

# --- Phase 5: token optimisations (all default true; set false to compare) ---
ENABLE_SEMANTIC_CACHE=true
CACHE_THRESHOLD=0.95
ENABLE_ROUTER_SHORTCUT=true
LAZY_SUMMARY=true
ENABLE_COMPRESSION=true
# JSONL per-request usage log directory ("" disables). Contains no message text.
USAGE_LOG_DIR=logs
# --- abuse controls (Phase 4) ---
RATE_LIMIT_USER_PER_MIN=20
RATE_LIMIT_IP_PER_MIN=60
DAILY_TOKEN_BUDGET_USER=50000
DAILY_TOKEN_BUDGET_ORG=1000000
# "mock" = bundled fake data for dev only. Use "none" until a real Grovator adapter exists.
PLATFORM_ADAPTER=mock

# --- Production: set ENVIRONMENT=production to enable startup safety checks. The app REFUSES to start if
# JWT_SECRET is the default/short, GROQ_API_KEY is empty, PLATFORM_ADAPTER=mock, REDIS_URL/QDRANT_URL=memory,
# or CORS_ORIGINS contains localhost or *.
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# Demo page auto-login (POST /demo/session). Local demo only; the app refuses to start in production with this on.
DEMO_MODE=true
SUMMARY_MODE=extractive

# --- LLM provider: "groq" (default) or "gemini". Put the key in backend/.env only, never here.
# With gemini, GEMINI_ANSWER_MODEL / GEMINI_ROUTER_MODEL are used instead of ANSWER_MODEL / ROUTER_MODEL.
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
# -1 = model default, 0 = no hidden thinking tokens
GEMINI_THINKING_BUDGET=-1

# --- application assistant (backend/knowledge/*)
# APP_KNOWLEDGE_DIR=            # default: backend/knowledge. Empty switches the application assistant off
# ENABLE_LONG_TERM_MEMORY=false # remember facts about the user across chats (extra model call). Off: students are anonymous
# HISTORY_TURNS=4               # last N turns sent verbatim; older ones are folded into the rolling summary
# VISION_MODEL=qwen/qwen3.8-27b # python -m ingest.vision
