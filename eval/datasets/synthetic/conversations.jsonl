{"id": "conv-chitchat", "role": "student", "turns": [{"q": "can you summarize the three pages about block coding", "expect_source": ["Block Coding Basics", "Blocks: Events", "Blocks: Control (loops and conditions)", "Loops and Conditions in Block Coding", "Blocks: Motion", "Blocks: Sensors", "Blocks: Variables and Operators", "Sample Block Programs", "Tool: Block Workspace"]}, {"q": "hello how are you", "expect_no_sources": true, "must_not_contain": ["summar", "three pages", "the pages you"]}, {"q": "who are you", "expect_no_sources": true, "must_contain_any": ["grovator assistant"]}, {"q": "what do you like to eat?", "expect_no_sources": true, "must_not_contain": ["summar", "three pages", "the pages you", "i love", "favourite", "favorite", "delicious", "yummy", "i like"]}, {"q": "ok, and what are the motion blocks?", "expect_source": ["Blocks: Motion"], "must_contain_any": ["move", "turn", "motor"]}]}
